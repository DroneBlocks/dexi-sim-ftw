<!--
  DEXI-3 Dev Kit body for Gazebo Classic (DexiSim). Derived from the stock PX4 iris.sdf in px4-gazebo-slim:0.23.11:
  the plugins, sensors and MAVLink wiring are the iris's, unchanged. Only the body numbers differ.

  Value                         Source
  total mass 0.432 kg           ASSUMED: the dexi-roadmap Dev Kit figure (381 g Flight Kit); no DEXI-3 has been weighed.
                                To change it, edit base_link mass (total = base_link 0.394 + imu 0.015 + gps 0.015 +
                                4 x rotor 0.002) and MPC_THR_HOVER in airframes/10050_gazebo-classic_dexi3 together.
  base inertia                  INFERRED: component box breakdown of the Dev Kit (battery, motors, CM5/FC stack, camera, flow
  ixx 0.000778 iyy 0.00102 izz 0.00144  sensor, plates), never measured. No log fit applied here (that is the dynamics change).
  motors at +-0.055 m            SOURCE: Dev Kit CAD, 110 x 110 mm motor square (RCINPOWER GTS V3 1404 4680 KV)
  prop radius 0.0381 m          SOURCE: Gemfan 3018 (3.0 in)
  motorConstant 1.4188e-06       CALCULATED: 700 g total thrust at maxRotVelocity 1100 rad/s. INFERRED: no thrust-stand data exists;
                                700 g = 432 g / the Dev Kit's logged hover thrust setpoint 0.613-0.662 over a pack (KB fact 299),
                                so it inherits the mass assumption.
  momentConstant 0.012          ASSUMED (no measurement; small-prop torque/thrust ratio). CA_ROTOR*_KM matches it.
  spin directions               SOURCE: DEXI-3 4701 airframe (rotor 0 front-right CCW, 1 rear-left CCW, 2 front-left CW,
                                3 rear-right CW): the same order and directions as the iris, so no change.
  time constants, rotor drag    iris values, NOT DEXI-3 (left for the log-fitted dynamics change)
  collision box 0.21x0.21x0.07  INFERRED from the frame plates (0.204 m) and battery height; its bottom is at the model
                                origin, because the entrypoint spawns at z = 0 (a box through the ground flips this light body)
-->
<sdf version='1.6'>
  <model name='dexi3'>
    <link name='base_link'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.394</mass>
        <inertia>
          <ixx>0.000778</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00102</iyy>
          <iyz>0</iyz>
          <izz>0.00144</izz>
        </inertia>
      </inertial>
      <collision name='base_link_inertia_collision'>
        <pose>0 0 0.036 0 0 0</pose>
        <geometry>
          <box>
            <size>0.21 0.21 0.07</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='base_link_inertia_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.21 0.21 0.07</size>
          </box>
        </geometry>
        <material>
          <script>
            <name>Gazebo/DarkGrey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <gravity>1</gravity>
      <velocity_decay/>
    </link>
    <link name='/imu_link'>
      <pose>0 0 0.02 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.015</mass>
        <inertia>
          <ixx>1e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-05</iyy>
          <iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
    </link>
    <joint name='/imu_joint' type='revolute'>
      <child>/imu_link</child>
      <parent>base_link</parent>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
          <effort>0</effort>
          <velocity>0</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>
    <link name='rotor_0'>
      <pose>0.055 -0.055 0.02 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.002</mass>
        <inertia>
          <ixx>1e-08</ixx>
