# Force Unix line endings for shell scripts (required for Docker/Linux compatibility)
*.sh text eol=lf

# Force Unix line endings for other scripts that may run in containers
*.bash text eol=lf
*.py text eol=lf
Dockerfile text eol=lf

# PX4 airframe files and Gazebo models are read inside Linux containers
px4-gazebo-slim/airframes/* text eol=lf
*.sdf text eol=lf
