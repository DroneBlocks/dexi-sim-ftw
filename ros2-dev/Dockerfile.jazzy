# ROS 2 Jazzy sim image: the DEXI workspace, rosbridge and code-server, no desktop.
# Jazzy because the aircraft runs Jazzy and dexi.repos pins Jazzy branches; the old
# Humble image only worked because those branches happened to build on both.
# Build from the repo root:  docker build -f ros2-dev/Dockerfile.jazzy -t droneblocks/dexi-sim-ros2:jazzy-headless .
FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=jazzy

# Build tools plus the Jazzy binaries for everything the workspace used to build from
# source and does not change: cv_bridge, image transport plugins, topic_tools.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates build-essential cmake \
        python3-pip python3-vcstool python3-colcon-common-extensions python3-rosdep \
        python3-opencv python3-numpy python3-yaml \
        libeigen3-dev \
        ros-jazzy-cv-bridge ros-jazzy-image-transport ros-jazzy-image-transport-plugins \
        ros-jazzy-camera-info-manager ros-jazzy-topic-tools ros-jazzy-tf2-ros \
        ros-jazzy-tf2-geometry-msgs ros-jazzy-rclcpp-components ros-jazzy-image-geometry \
        ros-jazzy-ament-cmake-mypy ros-jazzy-ament-lint-auto ros-jazzy-ament-lint-common \
    && rm -rf /var/lib/apt/lists/*

# Python the lessons and examples import: MAVSDK for the MAVSDK course, roslibpy for
# rosbridge clients, pysm for the offboard state machines. MAVSDK 4 ships a cmavsdk
# library that does not load on arm64 Ubuntu 24.04; 3.15.3 is what the lessons ran on.
RUN pip3 install --break-system-packages --no-cache-dir --ignore-installed typing_extensions pysm "mavsdk==3.15.3" roslibpy

WORKDIR /home/ubuntu/dexi_ws
COPY dexi_ws/src/dexi_bringup/dexi.repos src/dexi_bringup/dexi.repos
ARG CACHE_BUST=1
# Pull the workspace, then drop what the sim does not build: hardware-only packages,
# the agent (its own step), and the source copies of packages taken from apt above.
RUN vcs import src < src/dexi_bringup/dexi.repos && \
    rm -rf src/vision_opencv src/image_transport_plugins src/topic_tools \
           src/camera_ros src/web_video_server src/async_web_server_cpp \
           src/micro-ROS-Agent src/micro_ros_msgs \
           src/dexi_camera src/dexi_yolo src/dexi_gpio src/dexi_cpp
COPY dexi_ws/src/dexi_bringup src/dexi_bringup

RUN rosdep update --rosdistro jazzy && \
    apt-get update && \
    rosdep install --from-paths src --ignore-src -y --rosdistro jazzy \
        --skip-keys "ament_python camera_ros dexi_cpp clang-format ament_cmake_clang_format ament_cmake_cppcheck llama-cpp-python" && \
    rm -rf /var/lib/apt/lists/*

RUN bash -c "source /opt/ros/jazzy/setup.bash && \
    colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
      --packages-select \
        px4_msgs dexi_interfaces \
        rosbridge_test_msgs rosbridge_library rosapi_msgs rosapi rosbridge_msgs rosbridge_server \
        apriltag apriltag_msgs apriltag_ros \
        dexi_offboard dexi_led dexi_apriltag dexi_color_detection dexi_ctf dexi_llm dexi_tools dexi_bringup"

# code-server, as on the aircraft: VS Code in the browser opening the workspace, with
# native rclpy. Same port and password the sim always used.
RUN curl -fsSL https://code-server.dev/install.sh | sh && \
    mkdir -p /root/.config/code-server && \
    printf 'bind-addr: 0.0.0.0:9999\nauth: password\npassword: droneblocks\ncert: false\n' > /root/.config/code-server/config.yaml && \
    code-server --install-extension ms-python.python && \
    rm -rf /root/.cache

# The compose file bind-mounts the host checkout over /home/ubuntu/dexi_ws; the start
# script fills it from this stash when the host copy is not built.
RUN cp -a /home/ubuntu/dexi_ws /opt/dexi_ws_prebuilt

RUN for rc in /root/.bashrc /home/ubuntu/.bashrc; do \
      echo 'source /opt/ros/jazzy/setup.bash' >> $rc && \
      echo '[ -f /home/ubuntu/dexi_ws/install/setup.bash ] && source /home/ubuntu/dexi_ws/install/setup.bash' >> $rc; \
    done && \
    ln -sfn /home/ubuntu/dexi_ws /root/dexi_ws && \
    ln -sfn /home/ubuntu/scripts /root/scripts && \
    ln -sfn /home/ubuntu/dexi-mavsdk /root/dexi-mavsdk

COPY ros2-dev/start-sim.sh /usr/local/bin/start-sim.sh
RUN chmod +x /usr/local/bin/start-sim.sh
WORKDIR /home/ubuntu
EXPOSE 9090 9999
CMD ["/usr/local/bin/start-sim.sh"]
