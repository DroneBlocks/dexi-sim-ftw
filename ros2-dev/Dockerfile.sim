# Production image for sim deployment — workspace pre-compiled
# Built by GitHub Actions, pushed to droneblocks/dexi-sim-ros2:latest
#
# Build context must be the repo root:
#   docker build -f ros2-dev/Dockerfile.sim .
#
# Layer stack:
#   ros2-base (ROS2 Humble + px4_msgs)  →  rarely changes
#   dexi packages (colcon build)         →  changes when packages update
#   llama-cpp-python + startup scripts   →  changes frequently

FROM droneblocks/dexi-sim-ros2-base:humble-px4-1.16.0

WORKDIR /home/ubuntu

# Copy startup scripts
COPY ros2-dev/start-rosbridge.sh /usr/local/bin/start-rosbridge.sh
COPY ros2-dev/start-dexi-bringup.sh /usr/local/bin/start-dexi-bringup.sh
RUN chmod +x /usr/local/bin/start-rosbridge.sh && \
    chmod +x /usr/local/bin/start-dexi-bringup.sh

# Copy dexi.repos to import external dependencies
COPY dexi_ws/src/dexi_bringup/dexi.repos /home/ubuntu/dexi_ws/src/dexi_bringup/dexi.repos

# Cache-bust: dexi.repos pins 'main' branches, so we need to force
# fresh clones when upstream repos change (e.g. new interfaces/messages)
ARG CACHE_BUST=1

# Import all dependencies via vcs (clones apriltag, rosbridge, etc.)
RUN cd /home/ubuntu/dexi_ws && \
    vcs import src < src/dexi_bringup/dexi.repos

# Copy dexi_bringup from repo (contains launch files, dexi.repos already copied above)
# All other dexi packages (including dexi_llm) are cloned by vcs import from dexi.repos
COPY dexi_ws/src/dexi_bringup /home/ubuntu/dexi_ws/src/dexi_bringup

# Build the workspace (heavy compilation — do this before pip install for caching)
RUN bash -c "source /opt/ros/humble/setup.bash && \
    source /opt/px4_ws/install/setup.bash && \
    cd /home/ubuntu/dexi_ws && \
    colcon build --packages-select \
      dexi_interfaces dexi_offboard dexi_led dexi_bringup dexi_ctf \
      apriltag apriltag_msgs apriltag_ros dexi_apriltag \
      cv_bridge dexi_llm dexi_color_detection \
    --packages-ignore \
      dexi_cpp dexi_camera dexi_yolo camera_ros \
      compressed_depth_image_transport compressed_image_transport \
      theora_image_transport zstd_image_transport image_transport_plugins \
    --symlink-install"

# Install llama-cpp-python for local LLM inference (after colcon to avoid QEMU memory pressure)
#
# setuptools stays below 80 on purpose. colcon's --symlink-install builds every
# ament_python package by shelling out to `setup.py develop --editable`, and
# setuptools removed the develop command in 80.0. Ship an image carrying 80+ and
# the first `colcon build --symlink-install` anyone runs inside the container
# dies with "error: option --editable not recognized" on dexi_led, which then
# aborts every package downstream of it. The pin is re-applied after the
# llama-cpp-python install in case a transitive dependency pulls a newer one.
RUN pip3 install --upgrade pip packaging && \
    pip3 install "numpy<2" llama-cpp-python==0.2.90 && \
    pip3 install "setuptools<80" && \
    rm -rf /root/.cache/pip

# Stash pre-built workspace so bind mounts can be populated at runtime
RUN cp -a /home/ubuntu/dexi_ws /opt/dexi_ws_prebuilt

# Auto-source workspace
RUN echo 'source /opt/ros/humble/setup.bash' >> /home/ubuntu/.bashrc && \
    echo '[ -f /opt/px4_ws/install/setup.bash ] && source /opt/px4_ws/install/setup.bash' >> /home/ubuntu/.bashrc && \
    echo '[ -f ~/dexi_ws/install/setup.bash ] && source ~/dexi_ws/install/setup.bash' >> /home/ubuntu/.bashrc

# The VNC entrypoint needs root, so `docker compose exec ros2-dev bash` drops you
# in as root with HOME=/root while the workspace bind mount lands at
# /home/ubuntu/dexi_ws. Without these, every `~/dexi_ws` in the docs resolves to
# a directory that does not exist and the command fails with no useful message.
# The symlink targets are bind mounts that only exist at runtime, so they are
# dangling in the image by design.
RUN ln -sfn /home/ubuntu/dexi_ws /root/dexi_ws && \
    ln -sfn /home/ubuntu/scripts /root/scripts && \
    ln -sfn /home/ubuntu/dexi-mavsdk /root/dexi-mavsdk && \
    echo 'source /opt/ros/humble/setup.bash' >> /root/.bashrc && \
    echo '[ -f /opt/px4_ws/install/setup.bash ] && source /opt/px4_ws/install/setup.bash' >> /root/.bashrc && \
    echo '[ -f /home/ubuntu/dexi_ws/install/setup.bash ] && source /home/ubuntu/dexi_ws/install/setup.bash' >> /root/.bashrc

# Strip browsers from the VNC desktop. Cloud-sim students access the dashboard
# from their host browser (port 6080 noVNC, port 80 web-dashboard); they have
# no need to browse the open web from inside the container. AVR image inherits
# this since Dockerfile.avr is FROM droneblocks/dexi-sim-ros2:latest.
#
# tiryoh/ros2-desktop-vnc:humble installs Firefox by extracting a Mozilla
# tarball into /opt and symlinking /usr/bin/firefox, so apt has no record of
# the package. We do both: purge anything apt knows about AND nuke the on-disk
# files, so this works regardless of installation method.
RUN sudo bash -c 'set -e; \
    apt-get update; \
    pkgs=$(dpkg-query -W -f="\${Package}\n" "firefox*" "chromium*" "epiphany*" "midori*" "konqueror*" 2>/dev/null | tr "\n" " "); \
    if [ -n "$pkgs" ]; then apt-get purge -y $pkgs; fi; \
    apt-get autoremove -y; \
    rm -rf /usr/bin/firefox* /usr/bin/chromium* \
           /usr/lib/firefox* /usr/lib/chromium* \
           /opt/firefox* /opt/chromium* \
           /snap/firefox /snap/chromium; \
    find /usr/share/applications /etc/skel/Desktop /home/ubuntu/Desktop /home/ubuntu/.local/share/applications \
         \( -iname "firefox*.desktop" -o -iname "chromium*.desktop" \) \
         -delete 2>/dev/null || true; \
    rm -rf /var/lib/apt/lists/*; \
    echo "=== Verification (any output below is a leftover) ==="; \
    { ls -d /usr/bin/firefox* /usr/bin/chromium* /usr/lib/firefox* /usr/lib/chromium* /opt/firefox* /opt/chromium* 2>/dev/null || true; } | grep . || echo "(no binaries)"; \
    { find /usr/share/applications /home/ubuntu/Desktop /etc/skel/Desktop \( -iname "*firefox*" -o -iname "*chromium*" \) 2>/dev/null || true; } | grep . || echo "(no desktop entries)"; \
    echo "=== End verification ==="'
